{
  "name": "llmcrypto",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" -r typecheck && tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run packages tests/unit",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:contract": "vitest run tests/contracts",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "build": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" -r build",
    "dev": "pnpm --filter \"./apps/*\" --parallel -r dev"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "9.39.1",
    "@llmcrypto/contracts": "workspace:*",
    "@llmcrypto/domain": "workspace:*",
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.0",
    "@types/pg": "^8.23.1",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.1",
    "pg": "8.13.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "viem": "2.57.7",
    "vitest": "4.1.11",
    "yaml": "2.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/linux-x64"
    ]
  }
}
