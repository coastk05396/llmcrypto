# Placeholder names only. Never commit real values; copy to .env (git-ignored) locally.
DATABASE_URL=
SESSION_SECRET=
API_KEY_HASH_PEPPER=
KEY_REPLAY_ENCRYPTION_SECRET=
WEB_ORIGIN=
API_PORT=
PROVIDER_PRIMARY_API_KEY=
PROVIDER_PRIMARY_BASE_URL=
# JSON {"routes":[...]} of approved (network, asset) pairs; see docs/operations/payments.md. Empty = deposits disabled (503).
PAYMENT_NETWORKS_CONFIG=
# none (default) or test (TEST-ONLY address provider, refused in production). No real address source exists yet.
PAYMENT_ADDRESS_SOURCE=
PAYMENT_MAX_OPEN_INTENTS=
CHAIN_RPC_URL_EVM=
CHAIN_RPC_URL_TRON=
# Wallet sign-in policy (comma-separated). AUTH_DOMAIN defaults to the host of WEB_ORIGIN.
AUTH_DOMAIN=
AUTH_EVM_CHAIN_IDS=
AUTH_TRON_NETWORKS=
# Defaults true; set false only for plain-http local tools that are not browsers on localhost.
COOKIE_SECURE=
SESSION_TTL_SECONDS=
# Gateway (dev/test only provider): "fake" enables the deterministic FakeProvider; unset disables /v1/chat/completions and /v1/messages.
GATEWAY_PROVIDER=
GATEWAY_DEFAULT_MAX_OUTPUT_TOKENS=
GATEWAY_MAX_OUTPUT_TOKENS_CEILING=
GATEWAY_MAX_REQUEST_BYTES=
GATEWAY_PROVIDER_TIMEOUT_MS=
# Reconciliation window for requests with missing usage (default 86400; commercial policy unconfirmed).
GATEWAY_USAGE_PENDING_SECONDS=
GATEWAY_RATE_LIMIT_PER_MINUTE=
GATEWAY_MAX_CONCURRENT_PER_KEY=
# DEV/TEST ONLY: confirms the credit CLI (pnpm --filter @llmcrypto/api credit:dev <accountId> <microusd>) may run.
ALLOW_DEV_CREDIT=
# Test doubles (GATEWAY_PROVIDER=fake, PAYMENT_ADDRESS_SOURCE=test, the dev credit helper) work ONLY with ALLOW_TEST_COMPONENTS=true, whatever NODE_ENV is.
# Never set it in production. Secrets (SESSION_SECRET, API_KEY_HASH_PEPPER, KEY_REPLAY_ENCRYPTION_SECRET) must be at least 32 characters or the server refuses to start.
ALLOW_TEST_COMPONENTS=
# Comma-separated IPs of reverse proxies whose X-Forwarded-For is trusted for client-IP limits (empty = never trust the header).
TRUSTED_PROXIES=
API_MAX_BODY_BYTES=
# Beta areas (default off; off = unavailable, not complete). See docs/import-limits.md and SPEC.md "Beta tools".
FEATURE_REPOSITORY_GRAPH=
FEATURE_DESIGN_BETA=
REPOSITORY_MAX_ARCHIVE_BYTES=
REPOSITORY_MAX_FILES=
REPOSITORY_MAX_TOTAL_BYTES=
REPOSITORY_MAX_ACTIVE_PER_PROJECT=
REPOSITORY_MAX_RETAINED_PER_PROJECT=
DESIGN_MODEL=
DESIGN_MAX_OUTPUT_TOKENS=
DESIGN_MAX_REVISIONS=
DESIGN_MAX_PER_PROJECT=
DESIGN_MAX_ACTIVE_PER_ACCOUNT=
# Operators are granted out-of-band: comma-separated USER ids (not wallet addresses) or the operator CLI. See docs/operations/reconciliation.md.
OPERATOR_USER_IDS=
OPERATOR_ELEVATION_SECONDS=
OPERATOR_STEP_UP_WINDOW_SECONDS=
OPERATOR_ADJUSTMENT_MAX_MICROUSD=
OPERATOR_ADJUSTMENT_TTL_SECONDS=
OPERATOR_DAILY_LIMIT_MICROUSD=
OPERATOR_STUCK_RESERVATION_SECONDS=
