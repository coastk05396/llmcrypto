{
  "$schema": "internal: design token file, not a published JSON Schema",
  "name": "LLM Gateway (placeholder)",
  "version": "0.1.0",
  "source": {
    "darkPalette": "https://rickchen.si/assets/portfolio.css?v=20261014-folder-motion (inspected 2026-10-18 per SPEC.md)",
    "lightPalette": "Derived in this file; not supplied by the user. Contrast results are recorded in docs/design-system.md."
  },
  "color": {
    "dark": {
      "bg": "#202225",
      "surface": "#25282d",
      "bar": "#2b2e34",
      "inset": "#292e36",
      "text": "#f0f2f5",
      "muted": "#b5bfce",
      "border": "#49525f",
      "borderStrong": "#7b8695",
      "accent": "#dfbb76",
      "connector": "#aa8c56",
      "button": "#dfb66d",
      "buttonText": "#272017",
      "buttonBorder": "#dfb66d",
      "link": "#8bc9ed",
      "focus": "#8bc9ed",
      "success": "#48bb78",
      "warning": "#f0a45d",
      "danger": "#f4908a",
      "info": "#8bc9ed",
      "pending": "#b5bfce"
    },
    "light": {
      "bg": "#f6f3ec",
      "surface": "#ffffff",
      "bar": "#ece7db",
      "inset": "#f0ece2",
      "text": "#1f2125",
      "muted": "#4a5260",
      "border": "#cfc8b8",
      "borderStrong": "#6f7682",
      "accent": "#7a5710",
      "connector": "#8a6a2a",
      "button": "#dfb66d",
      "buttonText": "#272017",
      "buttonBorder": "#7a5710",
      "link": "#0a5a85",
      "focus": "#0a5a85",
      "success": "#17703f",
      "warning": "#8a4f00",
      "danger": "#b0231b",
      "info": "#0a5a85",
      "pending": "#4a5260"
    }
  },
  "chart": {
    "note": "Series are distinguished by hue AND dash/marker pattern AND direct label. Min 3:1 against surface.",
    "dark": ["#dfbb76", "#8bc9ed", "#48bb78", "#f4908a", "#c3a6f0"],
    "light": ["#7a5710", "#0a5a85", "#17703f", "#b0231b", "#6b3fb0"],
    "patterns": ["solid", "dash-4-3", "dot-1-3", "dash-8-3-1-3", "solid-marker-square"]
  },
  "font": {
    "display": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, \"Source Serif 4\", Georgia, serif",
    "body": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "mono": "ui-monospace, \"SF Mono\", \"Cascadia Mono\", \"JetBrains Mono\", Menlo, Consolas, monospace",
    "selfHostOptional": ["Source Serif 4 (OFL)", "JetBrains Mono (OFL)"]
  },
  "type": {
    "scale": {
      "xs":   { "size": "0.75rem",  "line": "1.125rem", "weight": 500, "tracking": "0.02em" },
      "sm":   { "size": "0.875rem", "line": "1.375rem", "weight": 400, "tracking": "0" },
      "base": { "size": "1rem",     "line": "1.625rem", "weight": 400, "tracking": "0" },
      "lg":   { "size": "1.125rem", "line": "1.75rem",  "weight": 500, "tracking": "0" },
      "xl":   { "size": "1.375rem", "line": "1.875rem", "weight": 600, "tracking": "-0.005em" },
      "2xl":  { "size": "1.75rem",  "line": "2.125rem", "weight": 600, "tracking": "-0.01em", "family": "display" },
      "3xl":  { "size": "clamp(2rem, 1.4rem + 2.4vw, 2.75rem)", "line": "1.1", "weight": 600, "tracking": "-0.015em", "family": "display" },
      "hero": { "size": "clamp(2.5rem, 1.2rem + 4.6vw, 4.5rem)", "line": "1.02", "weight": 600, "tracking": "-0.02em", "family": "display" },
      "amount": { "size": "clamp(2.25rem, 1.5rem + 3vw, 3.5rem)", "line": "1", "weight": 600, "family": "mono", "features": "tnum, zero" }
    }
  },
  "space": { "0": "0", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.5rem", "6": "2rem", "7": "3rem", "8": "4rem", "9": "6rem" },
  "radius": { "none": "0", "sm": "2px", "md": "4px", "lg": "8px", "pill": "999px" },
  "border": { "hairline": "1px", "rule": "2px" },
  "focus": {
    "width": "2px",
    "offset": "2px",
    "style": "solid",
    "color": "var(--focus)",
    "innerHaloNote": "Add a 1px bg-colored gap (outline-offset 2px) so the ring never merges with an adjacent same-hue fill."
  },
  "motion": {
    "duration": { "instant": "0ms", "fast": "120ms", "base": "200ms", "slow": "320ms" },
    "easing": { "out": "cubic-bezier(0.2, 0, 0, 1)", "inOut": "cubic-bezier(0.4, 0, 0.2, 1)" },
    "reducedMotion": "All durations resolve to 0ms and looping/auto-play motion is removed."
  },
  "layout": {
    "breakpoints": { "mobile": "390px reference, fluid from 320px", "tablet": "768px", "desktop": "1024px", "wide": "1440px reference" },
    "contentMax": "76rem",
    "readingMax": "68ch",
    "gutter": { "mobile": "1rem", "desktop": "2rem" },
    "minTarget": "44px"
  },
  "contrastRequirements": {
    "text": 4.5,
    "largeTextAndUi": 3.0,
    "reportedBy": "Contrast results summarized in docs/design-system.md; re-run when any color token changes"
  }
}
